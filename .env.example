# Local development only (npm run dev:api). In production these are Supabase secrets.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/pesapop
PORT=8787

# simulated (no real M-Pesa, labelled in the UI) | live (real PayHero STK Push; PayHero has no sandbox)
PROVIDER_MODE=simulated
MAX_AMOUNT=1000
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW_MINUTES=10
# Max M-Pesa prompts to one phone number per window (PayHero blocks a number after 10 failed prompts)
RATE_LIMIT_PER_PHONE=3
# Optional shared passcode for the demo site. Leave empty for no passcode.
DEMO_ACCESS_CODE=
CORS_ORIGINS=*
SHOP_NAME=PesaPop Demo Shop

# Optional. Without it the assistant runs in basic rule-based mode.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# PayHero (needed only for PROVIDER_MODE=live)
PAYHERO_BASE_URL=https://backend.payhero.co.ke
# PayHero dashboard -> API Keys -> Add new API Key -> copy the Basic Authorization token
PAYHERO_AUTH_TOKEN=
# PayHero dashboard -> Payment Channels -> My Payment Channels
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=
PAYHERO_CALLBACK_TOKEN=
