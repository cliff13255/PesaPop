# Copy to .env and fill in. NEVER commit .env or paste these values into Bubble.
NODE_ENV=development
PORT=3000

# Long random string (>= 32 chars), e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Supabase -> Project Settings -> Database -> Connection string
# Pooled (Transaction mode, port 6543). Used by the app at runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct (port 5432). Used only by `prisma migrate`.
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Comma-separated origins allowed by CORS (your Bubble app domains)
CORS_ORIGINS=https://pesapop.bubbleapps.io,https://pesapop.bubbleapps.io/version-test

# Phase 3 (assistant). Optional until then.
ANTHROPIC_API_KEY=

# Phase 3 (payments). Optional until then.
PROVIDER_MODE=sandbox
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_SECRET=

# Used by `npm run db:seed` for the demo accounts
SEED_PASSWORD=password123
